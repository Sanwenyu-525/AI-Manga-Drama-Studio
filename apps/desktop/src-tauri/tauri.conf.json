{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Manga Drama Studio",
  "version": "0.1.0",
  "identifier": "com.aimanga.studio",
  "build": {
    "beforeDevCommand": "node dev-keepalive.cjs",
    "devUrl": "http://127.0.0.1:17821",
    "beforeBuildCommand": "npm --prefix ../../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Manga Drama Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:17820 http://localhost:17820; connect-src 'self' http://127.0.0.1:17820 http://localhost:17820 ws://127.0.0.1:17820 ws://localhost:17820; font-src 'self' data:; media-src 'self' blob: data: http://127.0.0.1:17820 http://localhost:17820",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons-v2/32x32.png",
      "icons-v2/128x128.png",
      "icons-v2/128x128@2x.png",
      "icons-v2/icon.icns",
      "icons-v2/icon.ico"
    ]
  }
}
