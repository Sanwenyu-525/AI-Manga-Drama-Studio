# AI Manga Drama Studio — backend environment template
# Copy to backend/.env and fill in values. NEVER commit real secrets.
# Every variable is optional; defaults are safe for development (fake/mock).
# Full matrix + restart impact: docs/configuration-v0.1.md

# --- Environment -----------------------------------------------------------
# development | test | production. In production, fake/mock content providers
# are REFUSED at startup (fail-closed, P1-E5-T01) — set real ones below.
STUDIO_APP_ENV=development

# --- HTTP ------------------------------------------------------------------
STUDIO_HOST=127.0.0.1
STUDIO_PORT=17820
STUDIO_LOG_LEVEL=INFO
# Local session token (P1-E5-T02): normally set by the Tauri shell at spawn.
# When set, REST needs X-Session-Token and WS needs ?token= (health exempt).
# SECRET — never commit. Empty = dev/browser mode (auth off).
# STUDIO_SESSION_TOKEN=
# Comma-separated list of allowed browser origins.
# STUDIO_CORS_ORIGINS=http://localhost:17821,http://127.0.0.1:17821,tauri://localhost,http://tauri.localhost

# --- LLM (real chain) ------------------------------------------------------
# fake = deterministic local rule engine (dev/test only); openai = real endpoint.
STUDIO_LLM_MODE=fake
STUDIO_LLM_BASE_URL=https://api.deepseek.com/v1
# SECRET — never commit. Prefer the OS-level env, not a tracked file.
STUDIO_LLM_API_KEY=
STUDIO_LLM_MODEL=deepseek-chat

# --- Image generation ------------------------------------------------------
# mock = deterministic test image (dev/test only); comfyui = local server; agnes = cloud API.
STUDIO_IMAGE_PROVIDER=mock
STUDIO_COMFYUI_URL=http://127.0.0.1:8188
# SECRET — never commit.
STUDIO_AGNES_API_KEY=
STUDIO_AGNES_BASE_URL=https://api.agnes-ai.cn/v1

# --- Video generation ------------------------------------------------------
# mock = dev/test only; agnes = cloud video API.
STUDIO_VIDEO_PROVIDER=mock
STUDIO_VIDEO_MODEL=agnes-video-2.5-flash

# --- Episode render --------------------------------------------------------
# auto = local ffmpeg when present, else pure-python mock; mock|ffmpeg force.
STUDIO_RENDER_PROVIDER=auto

# --- Voiceover TTS ---------------------------------------------------------
# mock = deterministic WAV (dev/test only); edge = online neural voices (no key).
STUDIO_AUDIO_PROVIDER=mock
STUDIO_TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural

# --- Generation worker -----------------------------------------------------
# MVP is single-worker only (concurrency>1 is rejected at startup).
STUDIO_GENERATION_CONCURRENCY=1
STUDIO_GENERATION_MAX_ATTEMPTS=3
STUDIO_GENERATION_LEASE_SECONDS=120
STUDIO_GENERATION_RETRY_BACKOFF_BASE=1.0
STUDIO_GENERATION_RETRY_BACKOFF_MAX=60.0

# --- Paths -----------------------------------------------------------------
# SQLite + project assets directory.
# STUDIO_DATA_DIR=./data
# ComfyUI workflow template directory (default: repo-root/workflows/).
# STUDIO_WORKFLOWS_DIR=./workflows

# --- Workflow diagnostics (检查通道, P2-E4-T02) -----------------------------
# native = direct ComfyUI /object_info (default, no extra deps);
# mcp = user-installed comfy-mcp (pip install comfy-mcp, AGPL dual-license,
# NOT bundled). MCP failure auto-falls-back to native. Diagnostics only —
# the production execution channel is unaffected.
STUDIO_COMFY_INTROSPECTION=native
# STUDIO_COMFY_MCP_COMMAND=comfy-mcp
